# Local: use Railway Postgres or any PostgreSQL instance
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required: at least 32 characters in production
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Optional: folder for repair images (default: ./data/uploads)
# On Railway this is set to /data/uploads with a persistent volume
UPLOAD_DIR=""

# Public site URL used in LINE notification links
APP_URL="https://hopagtsc-production.up.railway.app"

# Optional LINE Messaging API fallback (Admin can also set these in /admin/line)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_TARGET_IDS=""
